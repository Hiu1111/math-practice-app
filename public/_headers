# Netlify response headers (privacy and security, TODO task 86).
# The Content-Security-Policy only allows this site's own files: the app cannot
# load trackers or ads, and the browser blocks any attempt to send data elsewhere.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files have content hashes in their names, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
